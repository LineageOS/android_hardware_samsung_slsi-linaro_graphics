      "writtenOn": "2026-11-24T15:22:37Z",
      "side": 1,
      "message": "I tried the blob patch ExtremeXT suggested instead. Rear photos, front camera, and video recording worked with the original 8-plane kernel and an 8-plane libhwjpeg. The fix is here: https://review.lineageos.org/514862",
      "parentUuid": "2899f71a_72031d3c",
      "revId": "538c21985fe79773f20a497f89e76249feb5274b",
      "serverId": "1ec6b3db-b2c1-4fa4-84a2-4c7efe89ba71"
