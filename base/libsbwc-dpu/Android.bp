cc_library_static {
    cflags: ["-DLOG_TAG=\"sbwcdecoder-dpu\""],
    name: "libsbwc-dpu",
    shared_libs: [
        "liblog",
        "libsync",
        "libion_exynos",
    ],
    export_include_dirs: ["include"],
    header_libs: [
        "libsystem_headers",
    ],
    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/include",
        "hardware/samsung_slsi-linaro/graphics/base/libhwc2.1/driver_header",
    ] + select(soong_config_variable("exynos_hwc", "target_soc_base"), {
        "exynos2100": [
            "hardware/samsung_slsi-linaro/graphics/base/libhwc2.1/platform/exynos2100",
        ],
        default: [],
    }),
    srcs: ["sbwcdecoder_dpu.cpp"],
    vendor:true,
}
